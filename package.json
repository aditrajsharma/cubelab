{
  "name": "cubelab",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "verify:cube": "rolldown src/cube/verify.ts --format esm --file node_modules/.tmp/verify.mjs --platform node && node node_modules/.tmp/verify.mjs",
    "check": "npm run verify:cube",
    "check:runtime": "node scripts/runtime-check.mjs",
    "look": "node scripts/look.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@turnwise/cube-solver": "^1.0.1",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
